# ═══════════════════════════════════════════════════════
#  BolãoCopa 2026 — Variáveis de Ambiente
# ═══════════════════════════════════════════════════════
#
#  ⚠️  O QUE VAI ONDE:
#
#  FRONTEND (Vercel)        → Variáveis VITE_ abaixo
#  BACKEND  (Supabase)      → supabase secrets set (sem VITE_)
#
# ═══════════════════════════════════════════════════════

# ── FRONTEND (configurar no Vercel como Environment Variables) ──

# Supabase — chaves públicas (podem ficar no frontend)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA

# ── BACKEND (configurar como Supabase Secrets) ──
# NUNCA coloque estas variáveis no frontend!
#
# Comando para configurar:
# supabase secrets set \
#   PUSHIN_PAY_TOKEN=SEU_TOKEN \
#   PUSHIN_WEBHOOK_SECRET=SEGREDO_RANDOMICO \
#   API_FOOTBALL_KEY=SUA_CHAVE \
#   WEBHOOK_URL=https://SEU_PROJETO.supabase.co/functions/v1/webhook-pushinpay

# Variáveis que ficam NO SUPABASE (não aqui):
# - PUSHIN_PAY_TOKEN          → Token da PushinPay (secreto!)
# - PUSHIN_WEBHOOK_SECRET     → Secret para validar webhooks
# - API_FOOTBALL_KEY          → Chave da API-Football
# - WEBHOOK_URL               → URL do webhook PushinPay
# - SUPABASE_URL              → URL do projeto (auto-configurado)
# - SUPABASE_SERVICE_ROLE_KEY → Service role key (auto-configurado)
